# Application
PORT=3000
JWT_SECRET=your-jwt-secret-key-here
STATIC_AUTH_TOKEN=your-static-bearer-token
API_PREFIX=/api

# Database (Raw SQL)
DB_URL=mysql://user:password@localhost:3306/legacy_database_name

# Caching (Valkey/Redis)
VALKEY_URI=redis://localhost:6379

# Event Messaging (NATS)
NATS_URI=nats://localhost:4222

# Network Services Exclusion (comma-separated ServiceIds)
EXCLUDED_NETWORK_SERVICES=II,FOP2P,SLPNM,BLINK,SLHOME,VPNCL,VPNSERVER,SL40,SLL500G,SFL500G,SLMB,SLPNMB,NFSF030,NFSF001,BC,SFL1TB,SFL2TB,SLPTPN500,SLPTPN40,SLPTPN1TB,PTP1CORE,SL2TB

